# 1. Copy this file and name the copy ".env"
# 2. Paste your keys from https://app.alpaca.markets (Paper Trading -> API Keys)
ALPACA_API_KEY=paste_your_key_id_here
ALPACA_SECRET_KEY=paste_your_secret_key_here

# true = practice account with fake money (strongly recommended while learning)
ALPACA_PAPER=true
