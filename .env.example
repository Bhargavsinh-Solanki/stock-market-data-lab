# Copy to .env and fill in. Never commit .env.

# --- storage ---
# DB_PATH=/absolute/path/to/platform.duckdb        # default: data/processed/platform.duckdb

# --- compliance / polite client ---
CONTACT_EMAIL=you@example.com          # goes into the User-Agent so sources can reach you
RESPECT_ROBOTS_TXT=true                # do not set to false
RATE_LIMIT_SECONDS=2.0
MAX_RETRIES=3

# --- source toggles ---
ENABLE_CAPITOL_TRADES=true
CAPITOL_TRADES_PAGES=5                 # daily incremental depth; for the one-time
                                       # full-history backfill run instead:
                                       # python scripts/run_daily_ingestion.py --backfill-political 400
ENABLE_HOUSE_DISCLOSURES=true
ENABLE_SENATE_DISCLOSURES=false        # opt-in; see README compliance notes

# --- global sources (all free, no keys) ---
INCLUDE_GLOBAL_ADRS=true               # Asian/European/LatAm ADRs in the universe
ENABLE_STOOQ=false                     # stooq.com robots.txt disallows the CSV path; keep off
ENABLE_ECB=true                        # ECB Data Portal — euro-area FX & rates
ENABLE_WORLD_BANK=true                 # World Bank API — global inflation/GDP

# --- API keys ---
FRED_API_KEY=                          # free: https://fred.stlouisfed.org/docs/api/api_key.html

# --- modeling ---
LABEL_HORIZON_DAYS=5
BACKTEST_TOP_K=10
TRANSACTION_COST_BPS=10

# --- optional MLflow tracking ---
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=political-trades-forecast
